              ]
            }
          }
        ]
      },
      {
        "name": "FactWorkOrder",
        "columns": [
          {
            "name": "FactWorkOrderKey",
            "dataType": "int64",
            "sourceColumn": "FactWorkOrderKey",
            "summarizeBy": "none",
            "isHidden": true,
            "isKey": true
          },
          {
            "name": "WorkOrderID",
            "dataType": "int64",
            "sourceColumn": "WorkOrderID",
            "summarizeBy": "none"
          },
          {
            "name": "ProductKey",
            "dataType": "int64",
            "sourceColumn": "ProductKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "ScrapReasonKey",
            "dataType": "int64",
            "sourceColumn": "ScrapReasonKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "StartDateKey",
            "dataType": "int64",
            "sourceColumn": "StartDateKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "EndDateKey",
            "dataType": "int64",
            "sourceColumn": "EndDateKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "DueDateKey",
            "dataType": "int64",
            "sourceColumn": "DueDateKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "OrderQty",
            "dataType": "int64",
            "sourceColumn": "OrderQty",
            "summarizeBy": "none"
          },
          {
            "name": "StockedQty",
            "dataType": "int64",
            "sourceColumn": "StockedQty",
            "summarizeBy": "none"
          },
          {
            "name": "ScrappedQty",
            "dataType": "int64",
            "sourceColumn": "ScrappedQty",
            "summarizeBy": "none"
          },
          {
            "name": "ScrapCost",
            "dataType": "decimal",
            "sourceColumn": "ScrapCost",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "FactWorkOrder",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(\"localhost,1433\", \"AdventureWorksDW\"),",
                "    Tabla = Origen{[Schema = \"dbo\", Item = \"FactWorkOrder\"]}[Data],",
                "    Seleccion = Table.SelectColumns(Tabla, {\"FactWorkOrderKey\", \"WorkOrderID\", \"ProductKey\", \"ScrapReasonKey\", \"StartDateKey\", \"EndDateKey\", \"DueDateKey\", \"OrderQty\", \"StockedQty\", \"ScrappedQty\", \"ScrapCost\"})",
                "in",
                "    Seleccion"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "P1 Ordenes",
            "expression": "COUNTROWS ( FactWorkOrder )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P1"
          },
          {
            "name": "P1 Unidades Ordenadas",
            "expression": "SUM ( FactWorkOrder[OrderQty] )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P1"
          },
          {
            "name": "P1 Unidades Almacenadas",
            "expression": "SUM ( FactWorkOrder[StockedQty] )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P1"
          },
          {
            "name": "P1 Unidades Descartadas",
            "expression": "SUM ( FactWorkOrder[ScrappedQty] )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P1"
          },
          {
            "name": "P2 Ordenes Con Descarte",
            "expression": "CALCULATE ( COUNTROWS ( FactWorkOrder ), KEEPFILTERS ( FactWorkOrder[ScrappedQty] > 0 ) )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P2"
          },
          {
            "name": "P2 Motivos Utilizados",
            "expression": "CALCULATE ( DISTINCTCOUNT ( FactWorkOrder[ScrapReasonKey] ), KEEPFILTERS ( FactWorkOrder[ScrappedQty] > 0 ), KEEPFILTERS ( FactWorkOrder[ScrapReasonKey] <> 0 ) )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P2"
          },
          {
            "name": "P2 Unidades Por Motivo",
            "expression": "IF ( [P1 Unidades Descartadas] > 0, [P1 Unidades Descartadas] )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P2"
          },
          {
            "name": "P2 Costo Estimado",
            "expression": "SUM ( FactWorkOrder[ScrapCost] )",
            "formatString": "#,0.00",
            "displayFolder": "Produccion/P2"
          },
          {
            "name": "P2 Tasa Descarte",
            "expression": "DIVIDE ( [P1 Unidades Descartadas], [P1 Unidades Ordenadas] )",
            "formatString": "0.00%",
            "displayFolder": "Produccion/P2"
          },
          {
            "name": "P2 Costo Por Motivo",
            "expression": "IF ( [P1 Unidades Descartadas] > 0, [P2 Costo Estimado] )",
            "formatString": "#,0.00",
            "displayFolder": "Produccion/P2"
          },
          {
            "name": "P1 Estado",
            "expression": "IF ( ISBLANK ( [P1 Ordenes] ), \"Sin órdenes para la selección. \", \"\" ) & \"Órdenes por fecha de inicio; unidades almacenadas de esas órdenes, no cierres del mes.\"",
            "formatString": "",
            "displayFolder": "Produccion/P1"
          },
          {
            "name": "P2 Estado",
            "expression": "\"Descarte / unidades ordenadas. Costo estimado con costo estándar; motivo registrado, no causa demostrada.\"",
            "formatString": "",
            "displayFolder": "Produccion/P2"
          },
          {
            "name": "P2 Descarte Acumulado Porcentaje",
            "expression": "VAR DescarteActual = [P2 Unidades Por Motivo] VAR TablaMotivos = ADDCOLUMNS ( ALLSELECTED ( DimScrapReason ), \"@Descarte\", [P2 Unidades Por Motivo] ) RETURN IF ( NOT ISBLANK ( DescarteActual ) && HASONEVALUE ( DimScrapReason[ScrapReasonKey] ), DIVIDE ( SUMX ( FILTER ( TablaMotivos, NOT ISBLANK ( [@Descarte] ) && [@Descarte] >= DescarteActual ), [@Descarte] ), SUMX ( TablaMotivos, [@Descarte] ) ) )",
            "formatString": "0.00%",
            "displayFolder": "Produccion/P2"
          }
        ]
      },
      {
        "name": "FactWorkOrderRouting",
        "columns": [
          {
