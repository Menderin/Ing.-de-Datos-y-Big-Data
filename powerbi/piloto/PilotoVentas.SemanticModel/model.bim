            "formatString": "#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "FactWorkOrderRouting",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(\"localhost,1433\", \"AdventureWorksDW\"),",
                "    Tabla = Origen{[Schema = \"dbo\", Item = \"FactWorkOrderRouting\"]}[Data],",
                "    Seleccion = Table.SelectColumns(Tabla, {\"FactRoutingKey\", \"WorkOrderID\", \"ProductKey\", \"LocationKey\", \"OperationSequence\", \"ScheduledStartDateKey\", \"ScheduledEndDateKey\", \"ActualStartDateKey\", \"ActualEndDateKey\", \"ActualResourceHrs\", \"PlannedCost\", \"ActualCost\", \"CostVariance\"})",
                "in",
                "    Seleccion"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "P4 Operaciones",
            "expression": "COUNTROWS ( FactWorkOrderRouting )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P4"
          },
          {
            "name": "P4 Horas",
            "expression": "SUM ( FactWorkOrderRouting[ActualResourceHrs] )",
            "formatString": "#,0.00",
            "displayFolder": "Produccion/P4"
          },
          {
            "name": "P4 Costo Real",
            "expression": "SUM ( FactWorkOrderRouting[ActualCost] )",
            "formatString": "#,0.00",
            "displayFolder": "Produccion/P4"
          },
          {
            "name": "P4 Costo Planificado",
            "expression": "SUM ( FactWorkOrderRouting[PlannedCost] )",
            "formatString": "#,0.00",
            "displayFolder": "Produccion/P4"
          },
          {
            "name": "P4 Variacion Costo",
            "expression": "SUM ( FactWorkOrderRouting[CostVariance] )",
            "formatString": "#,0.00",
            "displayFolder": "Produccion/P4"
          },
          {
            "name": "P4 Sin Inicio Real",
            "expression": "CALCULATE ( COUNTROWS ( FactWorkOrderRouting ), KEEPFILTERS ( FactWorkOrderRouting[ActualStartDateKey] = -1 ) )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P4"
          },
          {
            "name": "P4 Estado",
            "expression": "\"Operaciones por inicio real, no órdenes. Sin inicio informado: \" & FORMAT ( COALESCE ( [P4 Sin Inicio Real], 0 ), \"#,0\" ) & \". Horas consumidas no equivalen a utilización de capacidad.\"",
            "formatString": "",
            "displayFolder": "Produccion/P4"
          }
        ]
      },
      {
        "name": "FactInventorySnapshot",
        "columns": [
          {
            "name": "FactInventoryKey",
            "dataType": "int64",
            "sourceColumn": "FactInventoryKey",
            "summarizeBy": "none",
            "isHidden": true,
            "isKey": true
          },
          {
            "name": "ProductKey",
            "dataType": "int64",
            "sourceColumn": "ProductKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "LocationKey",
            "dataType": "int64",
            "sourceColumn": "LocationKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Shelf",
            "dataType": "string",
            "sourceColumn": "Shelf",
            "summarizeBy": "none"
          },
          {
            "name": "Bin",
            "dataType": "int64",
            "sourceColumn": "Bin",
            "summarizeBy": "none"
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "summarizeBy": "none"
          },
          {
            "name": "InventoryValue",
            "dataType": "decimal",
            "sourceColumn": "InventoryValue",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "FactInventorySnapshot",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(\"localhost,1433\", \"AdventureWorksDW\"),",
                "    Tabla = Origen{[Schema = \"dbo\", Item = \"FactInventorySnapshot\"]}[Data],",
                "    Seleccion = Table.SelectColumns(Tabla, {\"FactInventoryKey\", \"ProductKey\", \"LocationKey\", \"Shelf\", \"Bin\", \"Quantity\", \"InventoryValue\"})",
                "in",
                "    Seleccion"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "P3 Stock",
            "expression": "SUM ( FactInventorySnapshot[Quantity] )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P3"
          },
          {
            "name": "P3 Valor Estimado",
            "expression": "SUM ( FactInventorySnapshot[InventoryValue] )",
            "formatString": "#,0.00",
            "displayFolder": "Produccion/P3"
          },
          {
            "name": "P3 Productos Con Registro",
            "expression": "DISTINCTCOUNT ( FactInventorySnapshot[ProductKey] )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P3"
          },
          {
            "name": "P3 Stock Total Producto",
            "expression": "CALCULATE ( [P3 Stock], REMOVEFILTERS ( DimLocation ), REMOVEFILTERS ( FactInventorySnapshot[LocationKey], FactInventorySnapshot[Shelf], FactInventorySnapshot[Bin] ) )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P3"
          },
          {
            "name": "P3 Bajo Reorden",
            "expression": "SUMX ( VALUES ( DimProduct[ProductKey] ), VAR Existencias = [P3 Stock Total Producto] VAR Umbral = CALCULATE ( MAX ( DimProduct[ReorderPoint] ) ) RETURN IF ( NOT ISBLANK ( Existencias ) && Existencias < Umbral, 1, 0 ) )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P3"
          },
          {
            "name": "P3 Estado Stock",
            "expression": "VAR Local = [P3 Stock] VAR TotalProducto = [P3 Stock Total Producto] VAR Umbral = SELECTEDVALUE ( DimProduct[ReorderPoint] ) RETURN IF ( NOT ISBLANK ( Local ) && HASONEVALUE ( DimProduct[ProductKey] ), IF ( TotalProducto < Umbral, \"Bajo reorden global\", \"Sobre umbral global\" ) )",
            "formatString": "",
            "displayFolder": "Produccion/P3"
          },
          {
            "name": "P3 Estado",
            "expression": "\"Foto actual, sin histórico. Reorden compara stock global del producto; ubicación filtra stock y valor locales.\"",
            "formatString": "",
            "displayFolder": "Produccion/P3"
          },
          {
            "name": "P3 Brecha Reorden",
            "expression": "VAR StockGlobal = [P3 Stock Total Producto] RETURN IF ( HASONEVALUE ( DimProduct[ProductKey] ) && NOT ISBLANK ( StockGlobal ), StockGlobal - SELECTEDVALUE ( DimProduct[ReorderPoint] ) )",
            "formatString": "#,0",
            "displayFolder": "Produccion/P3"
          }
        ]
      },
