            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(\"localhost,1433\", \"AdventureWorksDW\"),",
                "    Tabla = Origen{[Schema = \"dbo\", Item = \"DimScrapReason\"]}[Data],",
                "    Seleccion = Table.SelectColumns(Tabla, {\"ScrapReasonKey\", \"ScrapReasonID\", \"ScrapReasonName\"})",
                "in",
